[opencode_install_include_paths]
.opencode/agents
.opencode/commands
.opencode/plugins
.opencode/.gitignore
.opencode/README.md
template/.opencode/agents/**
template/.opencode/commands/**
template/.opencode/model-catalog.local.example.json
template/.opencode/plugins/orchestrator.ts
template/.opencode/plugins/its-magic-auto/index.ts
# BUG-0021: tui.ts is framework-owned overwrite (copy2 even if dest exists).
# tui.json remains copy-if-absent / JSONC merge (BUG-0020 load path ≠ listing proof).
template/.opencode/plugins/its-magic-auto/tui.ts
# BUG-0023: shared Rpc.define contract — framework-owned overwrite (copy2).
template/.opencode/plugins/its-magic-auto/rpc.ts
.opencode/tui.json
template/.opencode/tui.json
scripts/opencode_model_catalog_apply.py

# [opencode_clean_paths] still lists `.opencode` so framework files are removed.
# Named operator locals listed in [model_config_preserve_paths] are
# exclude-from-clean (US-0132 / DEC-0132; not copy-aside).

[opencode_clean_paths]
.opencode

[model_config_preserve_paths]
.cursor/model-catalog.local.json
.cursor/scratchpad.local.md
.opencode/model-catalog.local.json
.opencode/opencode.json
.opencode/opencode.jsonc
opencode.json
opencode.jsonc

